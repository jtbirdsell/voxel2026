root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ follows upstream Luanti style (tabs, width 4) so quarried code stays consistent
[*.{cpp,hpp,h,c}]
indent_style = tab
indent_size = 4

[CMakeLists.txt]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2
